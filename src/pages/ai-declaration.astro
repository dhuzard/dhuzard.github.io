---
import Base from '~/layouts/Base.astro';
import { site } from '~/site.config';
import {
  declaration,
  inlineMarkdown,
  LEVELS,
  LEVEL_CLASSES,
  LEVEL_DEFINITIONS,
  PROCESSES,
  PROCESS_DEFINITIONS,
} from '~/ai-declaration';

const specUrl = `https://ai-declaration.md/en/${declaration.version}`;
---

<Base
  title="AI Declaration"
  description="How AI was used to build this site — declared with the AI-DECLARATION.md open standard."
>
  <article class="container-prose py-12 sm:py-16">
    <p class="section-eyebrow">AI Declaration</p>
    <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight">
      How AI was used to build this site
    </h1>

    <div class="prose prose-lg prose-ink dark:prose-invert mt-6">
      <p>
        I ask for transparency from others, so here is mine. Just as I publish a
        <a href="/coi/">conflict-of-interest statement</a>, I think anyone shipping software or writing in
        public should say plainly where the machine ended and the human began. Not as an apology — AI wrote
        most of the code on this site and I am not embarrassed by that — but because you deserve to know which
        parts to read with a skeptical eye.
      </p>
      <p>
        This page follows <a href={specUrl} rel="noopener">AI-DECLARATION.md</a>, an open standard for
        declaring AI involvement. The authoritative version is the
        <a href="/ai-declaration.md">machine-readable file</a> at the root of
        <a href="https://github.com/dhuzard/dhuzard.github.io" rel="noopener">the repository</a>; everything
        below is rendered from it.
      </p>
    </div>

    <section class="mt-10 card">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="section-eyebrow">Overall level</p>
          <p class="mt-2">
            <span
              class={`inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold ${LEVEL_CLASSES[declaration.level]}`}
            >
              ䷼ {declaration.level}
            </span>
          </p>
        </div>
        <p class="text-sm text-ink-500 dark:text-ink-400">
          Spec <a href={specUrl} rel="noopener">v{declaration.version}</a>
          · <a href="/ai-declaration.md">raw file</a>
        </p>
      </div>
      <p class="mt-4 text-sm text-ink-600 dark:text-ink-300">
        {LEVEL_DEFINITIONS[declaration.level]}
      </p>
    </section>

    <section class="mt-12">
      <h2 class="section-title">By process</h2>
      <ul class="mt-5 space-y-3">
        {
          PROCESSES.map((process) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-ink-100 pb-3 dark:border-ink-800">
              <span
                class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${LEVEL_CLASSES[declaration.processes[process]]}`}
              >
                {declaration.processes[process]}
              </span>
              <span class="font-medium text-ink-900 dark:text-ink-50">{process}</span>
              <span class="text-sm text-ink-500 dark:text-ink-400">
                {PROCESS_DEFINITIONS[process]}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      declaration.components.length > 0 && (
        <section class="mt-12">
          <h2 class="section-title">By component</h2>
          <ul class="mt-5 space-y-3">
            {declaration.components.map(({ path, level }) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-ink-100 pb-3 dark:border-ink-800">
                <span
                  class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${LEVEL_CLASSES[level]}`}
                >
                  {level}
                </span>
                <code class="text-sm text-ink-700 dark:text-ink-200">{path}</code>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-12">
      <h2 class="section-title">Notes</h2>
      <ul class="mt-5 space-y-3 text-ink-700 dark:text-ink-200">
        {
          declaration.notes.map((note) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500" />
              <span set:html={inlineMarkdown(note)} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="section-title">What the levels mean</h2>
      <p class="mt-3 text-sm text-ink-500 dark:text-ink-400">
        Defined by the specification as a combination of the verbs <em>act</em> and <em>prompt</em>.
      </p>
      <ul class="mt-5 space-y-3">
        {
          LEVELS.map((level) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-ink-100 pb-3 dark:border-ink-800">
              <span
                class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${LEVEL_CLASSES[level]}`}
              >
                {level}
              </span>
              <span class="text-sm text-ink-600 dark:text-ink-300">{LEVEL_DEFINITIONS[level]}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-12 text-sm text-ink-500 dark:text-ink-400">
      Something look wrong or under-declared? <a href={`mailto:${site.email}`}>Tell me</a> — this
      file is meant to be held to.
    </p>
  </article>
</Base>
