---
import Base from '~/layouts/Base.astro';
import OutputItem from '~/components/OutputItem.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

const recentOutputs = (await getCollection('outputs'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);
---

<Base title="Projects" description="Projects and tools by Damien Huzard.">
  <section class="container-wide py-12 sm:py-16">
    <p class="section-eyebrow">Things I build</p>
    <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight text-ink-900 dark:text-ink-50">Projects</h1>
    <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">
      Platforms, prototypes, and open tools — from FAIR metadata infrastructure to interactive ontology mapping.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}/`} class="card no-underline">
          {p.data.image && (
            <img src={p.data.image} alt={p.data.title} class="aspect-video w-full rounded-md object-contain bg-ink-50 dark:bg-ink-900" />
          )}
          <h2 class="mt-4 font-serif text-lg text-ink-900 dark:text-ink-50">{p.data.title}</h2>
          <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{p.data.summary}</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <span class="badge">{p.data.status}</span>
            {p.data.tags.map((t) => <span class="badge">{t}</span>)}
          </div>
        </a>
      ))}
    </div>

    {recentOutputs.length > 0 && (
      <section class="mt-14">
        <h2 class="font-serif text-2xl tracking-tight text-ink-900 dark:text-ink-50">Related outputs</h2>
        <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
          Software, roadmaps, and citable technical outputs connected to these projects.
        </p>
        <div class="mt-5 grid gap-4">
          {recentOutputs.map((o) => (
            <OutputItem {...o.data} />
          ))}
        </div>
        <p class="mt-4 text-sm"><a href="/outputs/">See all outputs →</a></p>
      </section>
    )}
  </section>
</Base>
