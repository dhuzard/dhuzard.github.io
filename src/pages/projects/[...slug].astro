---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="container-prose py-12 sm:py-16">
    <p class="section-eyebrow">Project</p>
    <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight text-ink-900 dark:text-ink-50">
      {entry.data.title}
    </h1>
    <p class="mt-3 text-ink-600 dark:text-ink-300">{entry.data.summary}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="badge">{entry.data.status}</span>
      {entry.data.tags.map((t) => <span class="badge">{t}</span>)}
    </div>
    {entry.data.image && (
      <img
        src={entry.data.image}
        alt={entry.data.title}
        class="mt-8 w-full rounded-xl border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 object-contain"
      />
    )}
    <div class="prose prose-ink dark:prose-invert mt-10 max-w-none">
      <Content />
    </div>
    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      {entry.data.url && (
        <a href={entry.data.url} class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700">
          Visit →
        </a>
      )}
      {entry.data.repo && (
        <a href={entry.data.repo} class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700">
          Repo →
        </a>
      )}
      <a href="/projects/" class="rounded-md px-3 py-1.5 no-underline text-ink-500">← All projects</a>
    </div>
  </article>
</Base>
