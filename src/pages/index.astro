---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import PaperItem from '~/components/PaperItem.astro';
import TalkItem from '~/components/TalkItem.astro';
import ScholarMetrics from '~/components/ScholarMetrics.astro';
import { getCollection } from 'astro:content';
import { site } from '~/site.config';

const recentPapers = (await getCollection('papers'))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const recentTalks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const expertise = [
  {
    title: 'Behavior research',
    body: 'Protocol design, automated phenotyping, home-cage monitoring, and reproducibility across species and labs.',
  },
  {
    title: 'Physiology & somatosensation',
    body: 'ECG / HRV analysis, skin-nerve recordings, and bio-behavioral phenotyping of stress and autism models.',
  },
  {
    title: 'FAIR metadata & data engineering',
    body: 'API-first metadata platforms, ontologies, JSON-LD, Python pipelines (Pandas, SciPy, Seaborn, statsmodels, DABEST).',
  },
];
---

<Base>
  <section class="border-b border-ink-100 dark:border-ink-800">
    <div class="container-wide grid gap-10 py-16 sm:py-24 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <p class="section-eyebrow">Neuro · physio · behaviorist · PhD</p>
        <h1 class="mt-3 font-serif text-4xl sm:text-5xl md:text-6xl tracking-tight text-ink-900 dark:text-ink-50">
          Damien Huzard
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-ink-200">
          I help preclinical labs describe their animals, devices, and protocols well — so behavior research becomes reproducible, comparable, and reusable.
          Founder of <a href={site.ventures.mapp}>MAPP</a> and <a href={site.ventures.neuronautix}>NeuroNautix</a>; moderator of <a href={site.ventures.behaviourForum}>The Behaviour Forum</a>.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/cv/"
            class="inline-flex items-center rounded-md bg-ink-900 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-ink-700 dark:bg-ink-50 dark:text-ink-900 dark:hover:bg-ink-200"
          >
            View CV
          </a>
          <a
            href={site.bookMeeting}
            class="inline-flex items-center rounded-md border border-ink-300 px-4 py-2 text-sm font-medium text-ink-800 no-underline hover:bg-ink-50 dark:border-ink-700 dark:text-ink-100 dark:hover:bg-ink-900"
          >
            Book a meeting
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center rounded-md border border-ink-300 px-4 py-2 text-sm font-medium text-ink-800 no-underline hover:bg-ink-50 dark:border-ink-700 dark:text-ink-100 dark:hover:bg-ink-900"
          >
            Email
          </a>
        </div>
        <dl class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-ink-500 dark:text-ink-400">
          <div>
            <dt class="sr-only">ORCID iD</dt>
            <dd>
              <a
                href={`https://orcid.org/${site.orcid}`}
                rel="me noopener"
                class="inline-flex items-center gap-1.5"
              >
                <svg
                  viewBox="0 0 256 256"
                  width="16"
                  height="16"
                  aria-hidden="true"
                  class="shrink-0"
                >
                  <path fill="#A6CE39" d="M256 128c0 70.7-57.3 128-128 128S0 198.7 0 128 57.3 0 128 0s128 57.3 128 128z" />
                  <g fill="#FFF">
                    <path d="M86.3 186.2H70.9V79.1h15.4v107.1z" />
                    <path d="M108.9 79.1h41.6c39.6 0 57 28.3 57 53.6 0 27.5-21.5 53.6-56.8 53.6h-41.8V79.1zm15.4 93.3h24.5c34.9 0 42.9-26.5 42.9-39.7 0-21.5-13.7-39.7-43.7-39.7h-23.7v79.4z" />
                    <path d="M88.7 56.8c0 5.5-4.5 10.1-10.1 10.1s-10.1-4.6-10.1-10.1c0-5.6 4.5-10.1 10.1-10.1s10.1 4.6 10.1 10.1z" />
                  </g>
                </svg>
                <span>orcid.org/{site.orcid}</span>
              </a>
            </dd>
          </div>
          <div><dt class="sr-only">Google Scholar</dt><dd><a href={site.scholar} rel="me noopener">Google Scholar</a></dd></div>
          <div><dt class="sr-only">Location</dt><dd>Montpellier, France</dd></div>
        </dl>
      </div>
      <div class="relative flex flex-col items-center gap-6 justify-self-center">
        <img
          src="/assets/images/dhuzard_profile_2025.jpg"
          alt="Damien Huzard"
          width="320"
          height="320"
          class="aspect-square w-64 sm:w-72 rounded-2xl object-cover shadow-sm ring-1 ring-ink-200 dark:ring-ink-800"
        />
        <div class="w-full max-w-xs sm:max-w-none">
          <ScholarMetrics />
        </div>
      </div>
    </div>
  </section>

  <Section eyebrow="What I do" title="Expertise">
    <div class="grid gap-5 sm:grid-cols-3">
      {expertise.map((e) => (
        <div class="card">
          <h3 class="font-serif text-base text-ink-900 dark:text-ink-50">{e.title}</h3>
          <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{e.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Recent publications" title="Papers">
    <div class="flex flex-col gap-4">
      {recentPapers.map((p) => (
        <PaperItem
          title={p.data.title}
          year={p.data.year}
          venue={p.data.venue}
          authors={p.data.authors}
          me={p.data.me}
          doi={p.data.doi}
          url={p.data.url}
          pdf={p.data.pdf}
          preprint={p.data.preprint}
          equalContribution={p.data.equalContribution}
          tags={p.data.tags}
        />
      ))}
    </div>
    <p class="text-sm"><a href="/papers/">All publications →</a></p>
  </Section>

  <Section eyebrow="Recent talks" title="Talks">
    <div class="grid gap-4 sm:grid-cols-2">
      {recentTalks.map((t) => (
        <TalkItem
          title={t.data.title}
          date={t.data.date}
          venue={t.data.venue}
          location={t.data.location}
          type={t.data.type}
          slides={t.data.slides}
          video={t.data.video}
          paper={t.data.paper}
          abstract={t.data.abstract}
        />
      ))}
    </div>
    <p class="text-sm"><a href="/talks/">All talks →</a></p>
  </Section>

  <Section eyebrow="Selected work" title="Projects" wide>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={p.data.url ?? `/projects/${p.slug}/`} class="card flex flex-col gap-3 no-underline">
          {p.data.image && (
            <img src={p.data.image} alt={p.data.title} class="aspect-video w-full rounded-md object-contain bg-ink-50 dark:bg-ink-900" />
          )}
          <h3 class="font-serif text-base text-ink-900 dark:text-ink-50">{p.data.title}</h3>
          <p class="text-sm text-ink-600 dark:text-ink-300">{p.data.summary}</p>
        </a>
      ))}
    </div>
    <p class="text-sm"><a href="/projects/">See all projects →</a></p>
  </Section>

  <Section eyebrow="From the blog" title="Recent writing">
    <ul class="divide-y divide-ink-100 dark:divide-ink-800">
      {posts.map((p) => (
        <li class="py-4">
          <a href={`/blog/${p.slug}/`} class="group flex flex-col gap-1 no-underline">
            <span class="text-xs text-ink-500 dark:text-ink-400 tabular-nums">
              {p.data.date.toISOString().slice(0, 10)}
            </span>
            <span class="font-serif text-lg text-ink-900 group-hover:text-accent-600 dark:text-ink-50 dark:group-hover:text-accent-300">
              {p.data.title}
            </span>
            {p.data.excerpt && (
              <span class="text-sm text-ink-600 dark:text-ink-300">{p.data.excerpt}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
    <p class="text-sm"><a href="/blog/">All posts →</a></p>
  </Section>
</Base>
