---
import Base from '~/layouts/Base.astro';
---

<Base title="Not found">
  <section class="container-prose py-24 text-center">
    <p class="section-eyebrow">404</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight text-ink-900 dark:text-ink-50">Page not found</h1>
    <p class="mt-3 text-ink-600 dark:text-ink-300">
      That page doesn't exist (or was moved during the site redesign).
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700">Home</a>
      <a href="/cv/" class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700">CV</a>
      <a href="/blog/" class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700">Blog</a>
    </div>
  </section>
</Base>
