---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateStr = entry.data.date.toISOString().slice(0, 10);
---

<Base title={entry.data.title} description={entry.data.excerpt} image={entry.data.image} pageType="article">
  <article class="container-prose py-12 sm:py-16">
    <p class="text-xs text-ink-500 dark:text-ink-400 tabular-nums">{dateStr}</p>
    <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight text-ink-900 dark:text-ink-50">
      {entry.data.title}
    </h1>
    {entry.data.excerpt && (
      <p class="mt-3 text-lg text-ink-600 dark:text-ink-300">{entry.data.excerpt}</p>
    )}
    {entry.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {entry.data.tags.map((t) => <span class="badge">{t}</span>)}
      </div>
    )}
    {entry.data.image && (
      <img
        src={entry.data.image}
        alt={entry.data.title}
        class="mt-8 w-full rounded-xl border border-ink-200 dark:border-ink-800 object-cover"
      />
    )}
    <div class="prose prose-lg prose-ink dark:prose-invert mt-10 max-w-none">
      <Content />
    </div>
    <hr class="my-12 border-ink-100 dark:border-ink-800" />
    <a href="/blog/" class="text-sm text-ink-500">← All posts</a>
  </article>
</Base>
