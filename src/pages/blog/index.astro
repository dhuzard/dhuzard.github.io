---
import Base from '~/layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog" description="Essays on behavior research, FAIR metadata, AI in science, and lab life.">
  <section class="container-prose py-12 sm:py-16">
    <p class="section-eyebrow">Writing</p>
    <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight text-ink-900 dark:text-ink-50">Blog</h1>
    <p class="mt-3 text-ink-600 dark:text-ink-300">
      Notes on behavior research, FAIR metadata, the FAIRRR framework, home-cage monitoring, AI in science, and lab life.
    </p>

    <ul class="mt-10 divide-y divide-ink-100 dark:divide-ink-800">
      {posts.map((p) => (
        <li class="py-5">
          <a href={`/blog/${p.slug}/`} class="group flex flex-col gap-1 no-underline">
            <span class="text-xs text-ink-500 dark:text-ink-400 tabular-nums">
              {p.data.date.toISOString().slice(0, 10)}
            </span>
            <span class="font-serif text-xl text-ink-900 group-hover:text-accent-600 dark:text-ink-50 dark:group-hover:text-accent-300">
              {p.data.title}
            </span>
            {p.data.excerpt && (
              <span class="text-sm text-ink-600 dark:text-ink-300">{p.data.excerpt}</span>
            )}
            {p.data.tags.length > 0 && (
              <span class="mt-1 flex flex-wrap gap-1.5">
                {p.data.tags.slice(0, 4).map((t) => <span class="badge">{t}</span>)}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
