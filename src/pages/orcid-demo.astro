---
import Base from '~/layouts/Base.astro';

const biosketchUrl =
  'https://raw.githubusercontent.com/dhuzard/orcid-biosketch/main/generated/biosketch.json';
const artifactBase =
  'https://raw.githubusercontent.com/dhuzard/orcid-biosketch/main/generated';
const wrappedUrl = `${artifactBase}/wrapped.json`;
const cardUrl = `${artifactBase}/card.svg`;
const heatmapUrl = `${artifactBase}/heatmap.svg`;
const fortuneUrl = `${artifactBase}/fortune.txt`;
---

<Base
  title="Live ORCID Biosketch Demo"
  description="A browser-time demonstration of an ORCID-synchronized, machine-readable researcher profile."
>
  <section class="border-b border-ink-100 dark:border-ink-800">
    <div class="container-prose py-14 sm:py-20">
      <p class="section-eyebrow">ORCID → biosketch → website</p>
      <h1 class="mt-3 font-serif text-4xl tracking-tight text-ink-900 dark:text-ink-50 sm:text-5xl">
        Live researcher profile
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">
        This page is static, but the profile is not. Your browser retrieves the latest versioned
        biosketch when you visit—so an ORCID update can reach this website without rebuilding it.
      </p>
    </div>
  </section>

  <section class="container-wide py-10 sm:py-14">
    <div class="screen-only mb-6 flex flex-wrap items-center justify-between gap-3">
      <div
        id="sync-status"
        class="flex items-center gap-2 text-sm text-ink-500 dark:text-ink-400"
        role="status"
        aria-live="polite"
      >
        <span class="h-2 w-2 animate-pulse rounded-full bg-amber-500" aria-hidden="true"></span>
        <span>Retrieving the current biosketch…</span>
      </div>
      <button
        id="export-pdf"
        type="button"
        disabled
        class="inline-flex items-center gap-2 rounded-md bg-ink-900 px-4 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-40 dark:bg-ink-50 dark:text-ink-900"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>
        </svg>
        Export biosketch PDF
      </button>
    </div>

    <article id="biosketch" class="card hidden" aria-labelledby="profile-name">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p id="profile-headline" class="section-eyebrow"></p>
          <h2 id="profile-name" class="mt-2 font-serif text-3xl text-ink-900 dark:text-ink-50"></h2>
        </div>
        <a
          id="profile-orcid"
          class="inline-flex shrink-0 items-center gap-2 rounded-md border border-ink-200 px-3 py-2 text-sm no-underline dark:border-ink-700"
          rel="me noopener"
        >
          <span class="h-3 w-3 rounded-full bg-[#A6CE39]" aria-hidden="true"></span>
          <span id="profile-orcid-label"></span>
        </a>
      </div>

      <div id="profile-biography" class="mt-7 space-y-4 text-ink-700 dark:text-ink-200"></div>

      <dl class="mt-8 grid gap-4 border-t border-ink-100 pt-6 text-sm dark:border-ink-800 sm:grid-cols-3">
        <div>
          <dt class="text-ink-500 dark:text-ink-400">Public outputs</dt>
          <dd id="works-count" class="mt-1 font-medium text-ink-900 dark:text-ink-50"></dd>
        </div>
        <div>
          <dt class="text-ink-500 dark:text-ink-400">ORCID record updated</dt>
          <dd id="source-updated" class="mt-1 font-medium text-ink-900 dark:text-ink-50"></dd>
        </div>
        <div>
          <dt class="text-ink-500 dark:text-ink-400">Loaded by this browser</dt>
          <dd id="browser-loaded" class="mt-1 font-medium text-ink-900 dark:text-ink-50"></dd>
        </div>
      </dl>
    </article>

    <section id="publication-explorer" class="mt-8 hidden" aria-labelledby="publications-title">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="section-eyebrow">Searchable ORCID outputs</p>
          <h2 id="publications-title" class="mt-2 font-serif text-2xl text-ink-900 dark:text-ink-50">
            Publications and research outputs
          </h2>
        </div>
        <p id="publication-count" class="text-sm tabular-nums text-ink-500 dark:text-ink-400" aria-live="polite"></p>
      </div>

      <div class="mt-5 grid gap-3 rounded-lg border border-ink-100 bg-ink-50 p-4 dark:border-ink-800 dark:bg-ink-900 sm:grid-cols-2 lg:grid-cols-4">
        <label class="sm:col-span-2">
          <span class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-300">Search</span>
          <input
            id="publication-search"
            type="search"
            placeholder="Title, journal, DOI, year…"
            class="w-full rounded-md border border-ink-200 bg-white px-3 py-2 text-sm text-ink-900 placeholder:text-ink-400 dark:border-ink-700 dark:bg-ink-950 dark:text-ink-50"
          />
        </label>
        <label>
          <span class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-300">Output type</span>
          <select id="publication-type" class="w-full rounded-md border border-ink-200 bg-white px-3 py-2 text-sm dark:border-ink-700 dark:bg-ink-950">
            <option value="">All types</option>
          </select>
        </label>
        <label>
          <span class="mb-1 block text-xs font-medium text-ink-600 dark:text-ink-300">Sort</span>
          <select id="publication-sort" class="w-full rounded-md border border-ink-200 bg-white px-3 py-2 text-sm dark:border-ink-700 dark:bg-ink-950">
            <option value="date-desc">Newest first</option>
            <option value="date-asc">Oldest first</option>
            <option value="title-asc">Title A–Z</option>
          </select>
        </label>
      </div>

      <div class="mt-4 overflow-x-auto rounded-lg border border-ink-100 dark:border-ink-800">
        <table class="w-full min-w-[700px] border-collapse text-left text-sm">
          <thead class="bg-ink-50 text-xs uppercase tracking-wide text-ink-500 dark:bg-ink-900 dark:text-ink-400">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">Year</th>
              <th scope="col" class="px-4 py-3 font-medium">Title</th>
              <th scope="col" class="px-4 py-3 font-medium">Venue</th>
              <th scope="col" class="px-4 py-3 font-medium">Type</th>
              <th scope="col" class="px-4 py-3 font-medium">Record</th>
            </tr>
          </thead>
          <tbody id="publication-rows" class="divide-y divide-ink-100 dark:divide-ink-800"></tbody>
        </table>
        <p id="publication-empty" class="hidden px-4 py-10 text-center text-sm text-ink-500 dark:text-ink-400">
          No outputs match these filters.
        </p>
      </div>
    </section>

    <div id="sync-error" class="card hidden border-red-200 dark:border-red-900" role="alert">
      <h2 class="font-serif text-xl text-ink-900 dark:text-ink-50">The live profile could not be loaded</h2>
      <p id="sync-error-message" class="mt-2 text-sm text-ink-600 dark:text-ink-300"></p>
      <button
        id="retry-sync"
        type="button"
        class="mt-4 rounded-md bg-ink-900 px-4 py-2 text-sm font-medium text-white dark:bg-ink-50 dark:text-ink-900"
      >
        Retry
      </button>
    </div>

    <section class="mt-16 border-t border-ink-100 pt-12 dark:border-ink-800" aria-labelledby="playful-title">
      <div class="max-w-3xl">
        <p class="section-eyebrow">Same data, less solemn</p>
        <h2 id="playful-title" class="mt-2 font-serif text-3xl text-ink-900 dark:text-ink-50 sm:text-4xl">
          An ORCID record can have a sense of humour
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600 dark:text-ink-300">
          The same versioned record also generates a yearly Wrapped, a researcher trading card,
          an honest publication heatmap, and a fortune made from one of my own paper titles.
          No credentials—or punchlines—are invented.
        </p>
      </div>

      <article class="card mt-8 p-6 sm:p-7" aria-labelledby="wrapped-title">
        <p class="section-eyebrow">ORCID Wrapped</p>
        <h3 id="wrapped-title" class="mt-2 font-serif text-2xl text-ink-900 dark:text-ink-50">
          <span id="wrapped-year">This year</span>, in metadata
        </h3>
        <dl class="mt-6 grid overflow-hidden rounded-lg border border-ink-100 bg-ink-50/70 dark:border-ink-800 dark:bg-ink-950/40 sm:grid-cols-2 lg:grid-cols-4">
          <div class="p-4 sm:p-5">
            <dt class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">This year</dt>
            <dd id="wrapped-output-count" class="mt-2 text-xl font-semibold tabular-nums text-ink-900 dark:text-ink-50">Loading…</dd>
          </div>
          <div class="border-t border-ink-100 p-4 dark:border-ink-800 sm:border-l sm:border-t-0 sm:p-5">
            <dt class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">Busiest career year</dt>
            <dd id="wrapped-busiest" class="mt-2 text-xl font-semibold text-ink-900 dark:text-ink-50">Loading…</dd>
          </div>
          <div class="border-t border-ink-100 p-4 dark:border-ink-800 sm:p-5 lg:border-l lg:border-t-0">
            <dt class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">Career record</dt>
            <dd id="wrapped-career" class="mt-2 text-xl font-semibold text-ink-900 dark:text-ink-50">Loading…</dd>
          </div>
          <div class="border-t border-ink-100 p-4 dark:border-ink-800 sm:border-l sm:p-5 lg:border-t-0">
            <dt class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">Titles drifted toward</dt>
            <dd id="wrapped-keywords" class="mt-2 text-base font-semibold leading-snug text-ink-900 dark:text-ink-50">Loading…</dd>
          </div>
        </dl>
        <p id="wrapped-note" class="sr-only" role="status">Retrieving the latest Wrapped…</p>
      </article>

      <article class="card mt-5 grid gap-6 p-6 sm:p-7 lg:grid-cols-[minmax(220px,0.45fr)_minmax(0,1fr)] lg:gap-10" aria-labelledby="fortune-title">
        <div>
          <p class="section-eyebrow">Academic fortune cookie</p>
          <h3 id="fortune-title" class="mt-2 font-serif text-2xl text-ink-900 dark:text-ink-50">
            A paper of my own, selected deterministically
          </h3>
        </div>
        <blockquote class="border-l-2 border-[#A6CE39] pl-5 sm:pl-6">
          <p id="academic-fortune" class="font-serif text-xl leading-relaxed text-ink-800 dark:text-ink-100 sm:text-2xl">
            Opening the cookie…
          </p>
          <footer class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-500 dark:text-ink-400">
            <span id="fortune-attribution"></span>
            <a id="fortune-link" class="hidden font-medium text-accent-700 dark:text-accent-300" target="_blank" rel="noopener">Read the paper ↗</a>
          </footer>
        </blockquote>
      </article>

      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <figure class="card flex flex-col p-4 sm:p-5">
          <div class="flex h-[28rem] items-center justify-center overflow-hidden rounded-lg bg-ink-50 p-3 dark:bg-ink-950/50 sm:h-[32rem]">
            <img src={cardUrl} alt="Researcher trading card generated from the live ORCID record" class="h-full w-full object-contain" loading="lazy" />
          </div>
          <figcaption class="mt-4 px-1 text-sm leading-relaxed text-ink-500 dark:text-ink-400">
            <strong class="text-ink-700 dark:text-ink-200">Researcher trading card.</strong>
            Years active become HP; outputs become attack; keywords supply the special ability.
            <span class="mt-2 block">
              Want your own QR? Sign in to ORCID, then open
              <strong class="text-ink-700 dark:text-ink-200">Account Settings → Sharing → Get a QR code for your ORCID iD</strong>.
              <a href="https://support.orcid.org/hc/en-us/articles/360006897654-Create-your-personal-ORCID-iD-QR-Code" target="_blank" rel="noopener">Official guide ↗</a>
            </span>
          </figcaption>
        </figure>
        <figure class="card flex flex-col p-4 sm:p-5">
          <div class="flex h-[28rem] items-center justify-center overflow-hidden rounded-lg bg-ink-50 p-3 dark:bg-ink-950/50 sm:h-[32rem]">
            <img src={heatmapUrl} alt="Publication activity heatmap generated from the live ORCID record" class="h-full w-full object-contain" loading="lazy" />
          </div>
          <figcaption class="mt-4 px-1 text-sm leading-relaxed text-ink-500 dark:text-ink-400">
            <strong class="text-ink-700 dark:text-ink-200">Publication heatmap.</strong>
            The contribution-grid treatment, including the quiet years a polished CV usually hides.
          </figcaption>
        </figure>
      </div>
    </section>

    <aside class="mt-8 rounded-lg bg-ink-50 p-5 text-sm text-ink-600 dark:bg-ink-900 dark:text-ink-300">
      <h2 class="font-serif text-base text-ink-900 dark:text-ink-50">What this demonstrates</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5">
        <li>ORCID remains the source for the public researcher record.</li>
        <li>The biosketch repository normalizes and versions that record each day.</li>
        <li>This page fetches the current JSON at visit time, independently of the website build.</li>
      </ol>
      <p class="mt-4">
        <a href={biosketchUrl}>Inspect the canonical JSON →</a>
      </p>
    </aside>
  </section>

  <section id="print-biosketch" class="hidden" aria-label="Printable biosketch">
    <header class="print-header">
      <p class="print-kicker">ORCID-synchronized biosketch</p>
      <h1 id="print-name"></h1>
      <p id="print-headline" class="print-headline"></p>
      <p id="print-identity" class="print-identity"></p>
    </header>
    <section class="print-section">
      <h2>Professional profile</h2>
      <div id="print-biography"></div>
    </section>
    <section id="print-employment-section" class="print-section">
      <h2>Employment</h2>
      <div id="print-employment"></div>
    </section>
    <section id="print-education-section" class="print-section">
      <h2>Education</h2>
      <div id="print-education"></div>
    </section>
    <section class="print-section">
      <h2>Research outputs</h2>
      <p id="print-output-summary" class="print-note"></p>
      <div id="print-works"></div>
    </section>
    <footer class="print-footer">
      <span>Source: ORCID and orcid-biosketch</span>
      <span id="print-generated"></span>
    </footer>
  </section>
</Base>

<style is:global>
  @media print {
    @page { size: A4 portrait; margin: 15mm 14mm 17mm; }
    html, body { background: #fff !important; color: #17202a !important; font-family: Arial, sans-serif !important; }
    body > header, body > footer, main > section:not(#print-biosketch), .screen-only { display: none !important; }
    main, #print-biosketch { display: block !important; }
    #print-biosketch { font-size: 9.5pt; line-height: 1.42; }
    .print-header { border-bottom: 2px solid #243447; padding-bottom: 5mm; margin-bottom: 6mm; }
    .print-kicker { margin: 0 0 2mm; color: #607080; font-size: 7.5pt; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    #print-biosketch h1 { margin: 0; font-family: Georgia, serif; font-size: 24pt; line-height: 1.1; color: #132238; }
    .print-headline { margin: 2mm 0 0; font-size: 11pt; color: #30445b; }
    .print-identity { margin: 2mm 0 0; font-size: 8.5pt; color: #607080; }
    .print-section { margin-top: 6mm; }
    .print-section h2 { margin: 0 0 3mm; border-bottom: 1px solid #ccd3da; padding-bottom: 1.5mm; font-family: Georgia, serif; font-size: 14pt; color: #132238; }
    .print-section p { margin: 0 0 2.5mm; }
    .print-entry { break-inside: avoid; margin-bottom: 3mm; }
    .print-entry-title { margin: 0; font-weight: 700; color: #17202a; }
    .print-entry-meta, .print-note { margin: .7mm 0 0 !important; color: #607080; font-size: 8.5pt; }
    .print-work { break-inside: avoid; display: grid; grid-template-columns: 14mm 1fr; gap: 3mm; padding: 2mm 0; border-bottom: .3pt solid #e1e5e9; }
    .print-work-year { color: #607080; font-variant-numeric: tabular-nums; }
    .print-work-title { margin: 0; font-weight: 600; }
    .print-work-meta { margin: .5mm 0 0; color: #607080; font-size: 8pt; }
    .print-footer { display: flex; justify-content: space-between; margin-top: 8mm; border-top: 1px solid #ccd3da; padding-top: 2mm; color: #607080; font-size: 7.5pt; }
    #print-biosketch a { color: inherit !important; text-decoration: none !important; }
  }
</style>

<script is:inline define:vars={{ biosketchUrl, wrappedUrl, fortuneUrl }}>
  const status = document.querySelector('#sync-status');
  const statusDot = status?.querySelector('span');
  const statusText = status?.querySelector('span:last-child');
  const profile = document.querySelector('#biosketch');
  const errorPanel = document.querySelector('#sync-error');
  const retry = document.querySelector('#retry-sync');
  const publicationExplorer = document.querySelector('#publication-explorer');
  const publicationSearch = document.querySelector('#publication-search');
  const publicationType = document.querySelector('#publication-type');
  const publicationSort = document.querySelector('#publication-sort');
  const exportPdf = document.querySelector('#export-pdf');
  let works = [];

  const setText = (selector, value) => {
    const element = document.querySelector(selector);
    if (element) element.textContent = value ?? '';
  };

  const formatDate = (value) => {
    if (!value) return 'Not reported';
    const date = new Date(value);
    return Number.isNaN(date.valueOf())
      ? 'Not reported'
      : new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(date);
  };

  const renderBiography = (text) => {
    const container = document.querySelector('#profile-biography');
    if (!container) return;
    container.replaceChildren();
    for (const paragraph of String(text || '').split(/\n\s*\n/).filter(Boolean)) {
      const node = document.createElement('p');
      node.textContent = paragraph;
      container.append(node);
    }
  };

  const workYear = (work) => String(work.publication_date || '').slice(0, 4);

  const safeHttpUrl = (value) => {
    if (!value) return '';
    try {
      const parsed = new URL(value, window.location.href);
      return ['http:', 'https:'].includes(parsed.protocol) ? parsed.href : '';
    } catch {
      return '';
    }
  };

  const workUrl = (work) => {
    const doi = work.identifiers?.doi;
    return safeHttpUrl(doi ? `https://doi.org/${doi}` : work.url);
  };

  const appendCell = (row, value, classes = '') => {
    const cell = document.createElement('td');
    cell.className = `px-4 py-3 align-top ${classes}`;
    cell.textContent = value || '—';
    row.append(cell);
    return cell;
  };

  const renderWorks = () => {
    const rows = document.querySelector('#publication-rows');
    const empty = document.querySelector('#publication-empty');
    if (!rows) return;

    const query = String(publicationSearch?.value || '').trim().toLocaleLowerCase();
    const type = String(publicationType?.value || '');
    const sort = String(publicationSort?.value || 'date-desc');
    const filtered = works.filter((work) => {
      if (type && work.type !== type) return false;
      const searchable = [
        work.title,
        work.journal,
        work.type,
        workYear(work),
        ...Object.values(work.identifiers || {}),
      ].join(' ').toLocaleLowerCase();
      return !query || searchable.includes(query);
    });

    filtered.sort((a, b) => {
      if (sort === 'title-asc') return String(a.title || '').localeCompare(String(b.title || ''));
      const comparison = String(a.publication_date || '').localeCompare(String(b.publication_date || ''));
      return sort === 'date-asc' ? comparison : -comparison;
    });

    rows.replaceChildren();
    for (const work of filtered) {
      const row = document.createElement('tr');
      row.className = 'bg-white text-ink-700 hover:bg-ink-50 dark:bg-ink-950 dark:text-ink-200 dark:hover:bg-ink-900';
      appendCell(row, workYear(work), 'tabular-nums text-ink-500 dark:text-ink-400');
      const titleCell = appendCell(row, '');
      const title = document.createElement('span');
      title.className = 'font-medium text-ink-900 dark:text-ink-50';
      title.textContent = work.title || 'Untitled output';
      titleCell.replaceChildren(title);
      appendCell(row, work.journal);
      appendCell(row, String(work.type || '').replaceAll('-', ' '));
      const recordCell = appendCell(row, '');
      const url = workUrl(work);
      if (url) {
        const link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = work.identifiers?.doi ? 'DOI ↗' : 'Open ↗';
        recordCell.replaceChildren(link);
      } else {
        recordCell.textContent = '—';
      }
      rows.append(row);
    }

    setText('#publication-count', `${filtered.length} of ${works.length} outputs`);
    empty?.classList.toggle('hidden', filtered.length !== 0);
    rows.closest('table')?.classList.toggle('hidden', filtered.length === 0);
  };

  const prepareWorks = (items) => {
    works = Array.isArray(items) ? items : [];
    const types = [...new Set(works.map((work) => work.type).filter(Boolean))].sort();
    if (publicationType) {
      for (const type of types) {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = String(type).replaceAll('-', ' ');
        publicationType.append(option);
      }
    }
    renderWorks();
    publicationExplorer?.classList.remove('hidden');
  };

  const appendPrintText = (container, text, className) => {
    const node = document.createElement('p');
    if (className) node.className = className;
    node.textContent = text || '';
    container.append(node);
    return node;
  };

  const renderPrintEntries = (selector, sectionSelector, entries) => {
    const container = document.querySelector(selector);
    const section = document.querySelector(sectionSelector);
    if (!container || !section) return;
    container.replaceChildren();
    section.classList.toggle('hidden', !entries.length);
    for (const entry of entries) {
      const item = document.createElement('div');
      item.className = 'print-entry';
      const title = [entry.role, entry.organization].filter(Boolean).join(', ');
      appendPrintText(item, title || 'Affiliation', 'print-entry-title');
      const dates = entry.start_date
        ? [entry.start_date, entry.end_date || 'present'].join(' - ')
        : entry.end_date || '';
      const details = [entry.department, dates].filter(Boolean).join(' | ');
      if (details) appendPrintText(item, details, 'print-entry-meta');
      container.append(item);
    }
  };

  const renderPrintDocument = (data) => {
    const person = data.person || {};
    setText('#print-name', person.name || 'Researcher biosketch');
    setText('#print-headline', person.headline || 'Researcher profile');
    setText('#print-identity', `ORCID: ${person.orcid || 'not reported'} | ${person.country || 'Country not reported'}`);
    const biography = document.querySelector('#print-biography');
    biography?.replaceChildren();
    for (const paragraph of String(person.biography || '').split(/\n\s*\n/).filter(Boolean)) {
      if (biography) appendPrintText(biography, paragraph);
    }
    renderPrintEntries('#print-employment', '#print-employment-section', data.employment || []);
    renderPrintEntries('#print-education', '#print-education-section', data.education || []);

    const output = document.querySelector('#print-works');
    output?.replaceChildren();
    const sortedWorks = [...(data.works || [])].sort((a, b) =>
      String(b.publication_date || '').localeCompare(String(a.publication_date || ''))
    );
    setText('#print-output-summary', `${sortedWorks.length} public outputs, ordered from newest to oldest.`);
    for (const work of sortedWorks) {
      const item = document.createElement('div');
      item.className = 'print-work';
      appendPrintText(item, workYear(work) || '—', 'print-work-year');
      const details = document.createElement('div');
      appendPrintText(details, work.title || 'Untitled output', 'print-work-title');
      const doi = work.identifiers?.doi;
      const meta = [work.journal, String(work.type || '').replaceAll('-', ' '), doi ? `doi:${doi}` : ''].filter(Boolean).join(' | ');
      if (meta) appendPrintText(details, meta, 'print-work-meta');
      item.append(details);
      output?.append(item);
    }
    setText('#print-generated', `Record updated ${formatDate(data.provenance?.generated_at)}`);
  };

  const render = (data) => {
    const person = data.person || {};
    setText('#profile-headline', person.headline || 'Public ORCID biosketch');
    setText('#profile-name', person.name || 'Unnamed researcher');
    setText('#profile-orcid-label', `ORCID ${person.orcid || ''}`);
    setText('#works-count', `${Array.isArray(data.works) ? data.works.length : 0} works`);
    setText('#source-updated', formatDate(data.provenance?.generated_at));
    setText('#browser-loaded', formatDate(new Date().toISOString()));
    renderBiography(person.biography);
    prepareWorks(data.works);

    const orcidLink = document.querySelector('#profile-orcid');
    const orcidUrl = safeHttpUrl(person.orcid_url);
    if (orcidLink && orcidUrl) orcidLink.href = orcidUrl;
  };

  const loadPlayfulExamples = async () => {
    try {
      const [wrappedResponse, fortuneResponse] = await Promise.all([
        fetch(`${wrappedUrl}?refresh=${Date.now()}`, { cache: 'no-store' }),
        fetch(`${fortuneUrl}?refresh=${Date.now()}`, { cache: 'no-store' }),
      ]);
      if (!wrappedResponse.ok || !fortuneResponse.ok) {
        throw new Error('The playful artifacts are not published yet.');
      }
      const wrapped = await wrappedResponse.json();
      const fortune = await fortuneResponse.text();
      setText('#wrapped-year', String(wrapped.year || 'This year'));
      setText('#wrapped-output-count', `${wrapped.output_count || 0} outputs`);
      setText(
        '#wrapped-busiest',
        wrapped.busiest_year ? `${wrapped.busiest_year.year} · ${wrapped.busiest_year.count} outputs` : 'Not enough dated outputs',
      );
      setText(
        '#wrapped-career',
        `${wrapped.totals?.outputs || 0} outputs · ${wrapped.career?.span_years || 0} years`,
      );
      setText('#wrapped-keywords', (wrapped.keyword_drift?.emerged || []).slice(0, 3).join(', ') || 'No new terms yet');
      setText('#wrapped-note', 'The latest Wrapped loaded successfully.');

      const normalizedFortune = fortune.replace(/\s+/g, ' ').trim();
      const parsedFortune = normalizedFortune.match(/^(.*?)\s+--\s+(.+?)(?:\s+(https?:\/\/\S+))?$/);
      const fortuneTitle = parsedFortune?.[1] || normalizedFortune;
      const fortuneAttribution = parsedFortune?.[2] || '';
      const fortunePaperUrl = safeHttpUrl(parsedFortune?.[3]);
      setText('#academic-fortune', fortuneTitle);
      setText('#fortune-attribution', fortuneAttribution ? `— ${fortuneAttribution}` : '');
      const fortuneLink = document.querySelector('#fortune-link');
      if (fortuneLink) {
        fortuneLink.classList.toggle('hidden', !fortunePaperUrl);
        if (fortunePaperUrl) fortuneLink.href = fortunePaperUrl;
        else fortuneLink.removeAttribute('href');
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'The playful artifacts could not be loaded.';
      setText('#wrapped-note', message);
      setText('#academic-fortune', message);
      setText('#fortune-attribution', '');
    }
  };

  const load = async () => {
    profile?.classList.add('hidden');
    errorPanel?.classList.add('hidden');
    status?.classList.remove('hidden');
    statusDot?.classList.add('animate-pulse', 'bg-amber-500');
    statusDot?.classList.remove('bg-emerald-500');
    if (statusText) statusText.textContent = 'Retrieving the current biosketch…';

    try {
      const response = await fetch(`${biosketchUrl}?refresh=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`The biosketch server returned HTTP ${response.status}.`);
      const data = await response.json();
      if (!data?.person?.orcid || !data?.provenance) throw new Error('The response is not a valid biosketch.');
      render(data);
      renderPrintDocument(data);
      if (exportPdf) exportPdf.disabled = false;
      profile?.classList.remove('hidden');
      statusDot?.classList.remove('animate-pulse', 'bg-amber-500');
      statusDot?.classList.add('bg-emerald-500');
      if (statusText) statusText.textContent = 'Live biosketch loaded successfully';
    } catch (error) {
      status?.classList.add('hidden');
      errorPanel?.classList.remove('hidden');
      setText('#sync-error-message', error instanceof Error ? error.message : 'Unknown synchronization error.');
    }
  };

  retry?.addEventListener('click', load);
  publicationSearch?.addEventListener('input', renderWorks);
  publicationType?.addEventListener('change', renderWorks);
  publicationSort?.addEventListener('change', renderWorks);
  exportPdf?.addEventListener('click', () => window.print());
  load();
  loadPlayfulExamples();
</script>
