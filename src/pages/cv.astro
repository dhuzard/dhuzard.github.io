---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import ExperienceItem from '~/components/ExperienceItem.astro';
import PaperItem from '~/components/PaperItem.astro';
import OutputItem from '~/components/OutputItem.astro';
import { getCollection, render } from 'astro:content';

const experience = (await getCollection('experience')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
const education = (await getCollection('education')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
const papers = (await getCollection('papers')).sort((a, b) => b.data.year - a.data.year);
const outputs = (await getCollection('outputs')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const awards = (await getCollection('awards')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const press = (await getCollection('press')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const responsibilities = (await getCollection('responsibilities')).sort((a, b) =>
  b.data.period.localeCompare(a.data.period)
);
const students = await getCollection('students');

const renderedExperience = await Promise.all(
  experience.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);
const renderedEducation = await Promise.all(
  education.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);
---

<Base
  title="CV"
  description="CV of Damien Huzard — neuro-physio-behaviorist, founder of MAPP and NeuroNautix."
>
  <section class="border-b border-ink-100 dark:border-ink-800">
    <div class="container-wide py-12 sm:py-16">
      <p class="section-eyebrow">Curriculum Vitae</p>
      <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight text-ink-900 dark:text-ink-50">
        Damien Huzard — Neuro-physio-behaviorist, PhD
      </h1>
      <p class="mt-4 max-w-3xl text-ink-700 dark:text-ink-200">
        Over a decade of multidisciplinary research at the intersection of neurophysiology, behavior, and data
        science. Specialised in neurodevelopmental disorders (ASD) and home-cage monitoring to improve
        preclinical and translational outcomes. Track record of leading projects, analysing large datasets, and
        publishing in high-impact venues.
      </p>
      <div class="mt-5 flex flex-wrap gap-3 text-sm">
        <a class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700" href="/assets/PDFs/CV.pdf">Download PDF</a>
        <a class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700" href="/papers/">All papers →</a>
        <a class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700" href="/outputs/">All outputs →</a>
        <a class="rounded-md border border-ink-300 px-3 py-1.5 no-underline dark:border-ink-700" href="/talks/">All talks →</a>
      </div>
    </div>
  </section>

  <Section eyebrow="Where I work" title="Experience" wide>
    <div class="grid gap-4">
      {renderedExperience.map(({ entry, Content }) => (
        <ExperienceItem
          role={entry.data.role}
          org={entry.data.org}
          orgUrl={entry.data.orgUrl}
          location={entry.data.location}
          start={entry.data.start}
          end={entry.data.end}
          current={entry.data.current}
          summary={entry.data.summary}
          tags={entry.data.tags}
        >
          <Content />
        </ExperienceItem>
      ))}
    </div>
  </Section>

  <Section eyebrow="Training" title="Education" wide>
    <div class="grid gap-4">
      {renderedEducation.map(({ entry }) => (
        <article class="card">
          <header class="flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h3 class="font-serif text-lg text-ink-900 dark:text-ink-50">{entry.data.degree}</h3>
              <p class="text-sm text-ink-600 dark:text-ink-300">
                {entry.data.orgUrl ? <a href={entry.data.orgUrl}>{entry.data.org}</a> : entry.data.org}
                {entry.data.location && <span class="text-ink-500"> · {entry.data.location}</span>}
              </p>
            </div>
            <span class="text-sm text-ink-500 dark:text-ink-400 tabular-nums">
              {entry.data.start} – {entry.data.end}
            </span>
          </header>
          {entry.data.summary && <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{entry.data.summary}</p>}
          {entry.data.gpa && <p class="mt-1 text-xs text-ink-500">GPA {entry.data.gpa}</p>}
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Publications" title="Papers" wide description="Full list with DOIs and PDFs.">
    <div class="grid gap-4">
      {papers.map((p) => (
        <PaperItem {...p.data} />
      ))}
    </div>
  </Section>

  <Section eyebrow="ORCID records" title="Outputs" wide description="Software, protocols, roadmaps, and other citable records.">
    <div class="grid gap-4">
      {outputs.map((o) => (
        <OutputItem {...o.data} />
      ))}
    </div>
  </Section>

  <Section eyebrow="Recognition" title="Grants & Awards" wide>
    <ul class="divide-y divide-ink-100 dark:divide-ink-800">
      {awards.map((a) => (
        <li class="flex flex-wrap items-baseline justify-between gap-3 py-3">
          <div>
            <p class="font-medium text-ink-900 dark:text-ink-50">
              {a.data.url ? <a href={a.data.url}>{a.data.title}</a> : a.data.title}
              {a.data.amount && <span class="ml-2 text-sm text-ink-500">({a.data.amount})</span>}
            </p>
            {a.data.description && <p class="text-sm text-ink-600 dark:text-ink-300">{a.data.description}</p>}
            <p class="text-xs text-ink-500">{a.data.org}</p>
          </div>
          <span class="text-sm text-ink-500 tabular-nums">{a.data.date}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Outreach" title="Press & media" wide>
    <ul class="divide-y divide-ink-100 dark:divide-ink-800">
      {press.map((p) => (
        <li class="flex flex-wrap items-baseline justify-between gap-3 py-3">
          <div>
            <p class="font-medium text-ink-900 dark:text-ink-50">
              {p.data.url ? <a href={p.data.url}>{p.data.title}</a> : p.data.title}
            </p>
            <p class="text-xs text-ink-500">{p.data.outlet} · {p.data.type} · {p.data.language.toUpperCase()}</p>
          </div>
          <span class="text-sm text-ink-500 tabular-nums">{p.data.date}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Service" title="Responsibilities" wide>
    <ul class="divide-y divide-ink-100 dark:divide-ink-800">
      {responsibilities.map((r) => (
        <li class="flex flex-wrap items-baseline justify-between gap-3 py-3">
          <p class="font-medium text-ink-900 dark:text-ink-50">
            {r.data.url ? <a href={r.data.url}>{r.data.title}</a> : r.data.title}
            {r.data.org && <span class="ml-2 text-xs text-ink-500">· {r.data.org}</span>}
          </p>
          <span class="text-sm text-ink-500 tabular-nums">{r.data.period}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Mentoring" title="Students supervised" wide>
    <div class="grid gap-3 sm:grid-cols-2">
      {students.map((s) => (
        <div class="card">
          <p class="font-medium text-ink-900 dark:text-ink-50">{s.data.name}</p>
          <p class="text-xs text-ink-500">{s.data.level} · {s.data.period}</p>
          <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{s.data.topic}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Get in touch" title="Contact" wide>
    <div class="card">
      <p>Email: <a href="mailto:damien.huzard@gmail.com">damien.huzard@gmail.com</a></p>
      <p>LinkedIn: <a href="https://www.linkedin.com/in/dhuzard/">linkedin.com/in/dhuzard</a></p>
      <p>Book a meeting: <a href="https://koalendar.com/e/meet-with-damien-huzard">koalendar.com/e/meet-with-damien-huzard</a></p>
    </div>
  </Section>
</Base>
