---
import Base from '~/layouts/Base.astro';
import PaperItem from '~/components/PaperItem.astro';
import PublicationsSchema from '~/components/PublicationsSchema.astro';
import { getCollection } from 'astro:content';
import { site } from '~/site.config';

const papers = (await getCollection('papers')).sort((a, b) => b.data.year - a.data.year);
const byYear = papers.reduce<Record<number, typeof papers>>((acc, p) => {
  acc[p.data.year] = acc[p.data.year] ?? [];
  acc[p.data.year].push(p);
  return acc;
}, {});
const years = Object.keys(byYear)
  .map((y) => Number(y))
  .sort((a, b) => b - a);
---

<Base title="Papers" description="Peer-reviewed papers and preprints by Damien Huzard.">
  <PublicationsSchema papers={papers.map((p) => p.data)} />
  <section class="container-wide py-12 sm:py-16">
    <p class="section-eyebrow">Publications</p>
    <h1 class="mt-2 font-serif text-3xl sm:text-4xl tracking-tight text-ink-900 dark:text-ink-50">Papers</h1>
    <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">
      Peer-reviewed articles, reviews, and preprints. Full list on <a href={site.scholar}>Google Scholar</a>.
    </p>

    <div class="mt-10 space-y-12">
      {years.map((year) => (
        <section>
          <h2 class="section-title mb-4">{year}</h2>
          <div class="grid gap-4">
            {byYear[year].map((p) => <PaperItem {...p.data} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>
