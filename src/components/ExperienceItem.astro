---
interface Props {
  role: string;
  org: string;
  orgUrl?: string;
  location?: string;
  start: string;
  end?: string;
  current?: boolean;
  summary?: string;
  tags?: string[];
}

const { role, org, orgUrl, location, start, end, current = false, summary, tags = [] } = Astro.props;
const endLabel = current ? 'Present' : end ?? '';
---

<article class="card">
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <div>
      <h3 class="font-serif text-lg text-ink-900 dark:text-ink-50">{role}</h3>
      <p class="text-sm text-ink-600 dark:text-ink-300">
        {orgUrl ? <a href={orgUrl} class="no-underline hover:underline">{org}</a> : org}
        {location && <span class="text-ink-500"> · {location}</span>}
      </p>
    </div>
    <span class="text-sm text-ink-500 dark:text-ink-400 tabular-nums">
      {start} – {endLabel}
    </span>
  </header>
  {summary && <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">{summary}</p>}
  <div class="prose prose-sm dark:prose-invert mt-3 max-w-none">
    <slot />
  </div>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((t) => <span class="badge">{t}</span>)}
    </div>
  )}
</article>
