---
interface Props {
  title: string;
  date: string;
  type: 'other' | 'software' | 'protocol' | 'roadmap' | 'dataset' | 'thesis';
  venue?: string;
  authors?: string[];
  dois?: string[];
  url?: string;
  source?: string;
  tags?: string[];
}

const {
  title,
  date,
  type,
  venue,
  authors = [],
  dois = [],
  url,
  source,
  tags = [],
} = Astro.props;

const typeLabel = {
  other: 'Other',
  software: 'Software',
  protocol: 'Protocol',
  roadmap: 'Roadmap',
  dataset: 'Dataset',
  thesis: 'Thesis',
}[type];
---

<article class="card">
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-serif text-base leading-snug text-ink-900 dark:text-ink-50">
      {url ? <a href={url}>{title}</a> : title}
    </h3>
    <span class="text-sm text-ink-500 dark:text-ink-400 tabular-nums">{date}</span>
  </header>

  <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
    <span class="badge badge-accent mr-2">{typeLabel}</span>
    {venue && <span>{venue}</span>}
  </p>

  {dois.length > 0 && (
    <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
      DOI: {dois.map((d, i) => (
        <span>
          <a class="text-accent-600 dark:text-accent-300" href={`https://doi.org/${d}`}>{d}</a>{i < dois.length - 1 ? ', ' : ''}
        </span>
      ))}
    </p>
  )}

  {authors.length > 0 && (
    <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">Contributors: {authors.join('; ')}</p>
  )}

  {source && <p class="mt-1 text-xs text-ink-500">Source: {source}</p>}

  {tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-2">
      {tags.map((t) => <span class="badge">{t}</span>)}
    </div>
  )}
</article>
