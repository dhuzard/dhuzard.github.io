---
// Renders the repo-root AI-DECLARATION.md. Everything here comes from that
// file — see src/ai-declaration.ts for the parser and its validation.
import {
  declaration,
  inlineMarkdown,
  LEVELS,
  LEVEL_CLASSES,
  LEVEL_DEFINITIONS,
  PROCESSES,
  PROCESS_DEFINITIONS,
} from '~/ai-declaration';

const specUrl = `https://ai-declaration.md/en/${declaration.version}`;
---

<div class="card">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="section-eyebrow">Overall level</p>
      <p class="mt-2">
        <span
          class={`inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold ${LEVEL_CLASSES[declaration.level]}`}
        >
          ䷼ {declaration.level}
        </span>
      </p>
    </div>
    <p class="text-sm text-ink-500 dark:text-ink-400">
      Spec <a href={specUrl} rel="noopener">v{declaration.version}</a>
      · <a href="/ai-declaration.md">raw file</a>
    </p>
  </div>
  <p class="mt-4 text-sm text-ink-600 dark:text-ink-300">
    {LEVEL_DEFINITIONS[declaration.level]}
  </p>
</div>

<h3 class="mt-10 font-serif text-xl tracking-tight text-ink-900 dark:text-ink-50">By process</h3>
<ul class="mt-4 space-y-3">
  {
    PROCESSES.map((process) => (
      <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-ink-100 pb-3 dark:border-ink-800">
        <span
          class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${LEVEL_CLASSES[declaration.processes[process]]}`}
        >
          {declaration.processes[process]}
        </span>
        <span class="font-medium text-ink-900 dark:text-ink-50">{process}</span>
        <span class="text-sm text-ink-500 dark:text-ink-400">{PROCESS_DEFINITIONS[process]}</span>
      </li>
    ))
  }
</ul>

{
  declaration.components.length > 0 && (
    <>
      <h3 class="mt-10 font-serif text-xl tracking-tight text-ink-900 dark:text-ink-50">
        By component
      </h3>
      <ul class="mt-4 space-y-3">
        {declaration.components.map(({ path, level }) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-ink-100 pb-3 dark:border-ink-800">
            <span
              class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${LEVEL_CLASSES[level]}`}
            >
              {level}
            </span>
            <code class="text-sm text-ink-700 dark:text-ink-200">{path}</code>
          </li>
        ))}
      </ul>
    </>
  )
}

<h3 class="mt-10 font-serif text-xl tracking-tight text-ink-900 dark:text-ink-50">Notes</h3>
<ul class="mt-4 space-y-3 text-ink-700 dark:text-ink-200">
  {
    declaration.notes.map((note) => (
      <li class="flex gap-3">
        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500" />
        <span set:html={inlineMarkdown(note)} />
      </li>
    ))
  }
</ul>

<details class="mt-8 text-sm">
  <summary class="cursor-pointer text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-ink-50">
    What the levels mean
  </summary>
  <p class="mt-3 text-ink-500 dark:text-ink-400">
    Defined by the specification as a combination of the verbs <em>act</em> and <em>prompt</em>.
  </p>
  <ul class="mt-4 space-y-3">
    {
      LEVELS.map((level) => (
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span
            class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${LEVEL_CLASSES[level]}`}
          >
            {level}
          </span>
          <span class="text-ink-600 dark:text-ink-300">{LEVEL_DEFINITIONS[level]}</span>
        </li>
      ))
    }
  </ul>
</details>
