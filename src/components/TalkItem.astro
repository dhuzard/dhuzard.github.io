---
interface Props {
  title: string;
  date: string;
  venue: string;
  location?: string;
  type: 'oral' | 'invited' | 'keynote' | 'poster' | 'webinar' | 'short' | 'participation';
  slides?: string;
  video?: string;
  paper?: string;
  abstract?: string;
}

const { title, date, venue, location, type, slides, video, paper, abstract } = Astro.props;

const typeLabel = {
  oral: 'Oral',
  invited: 'Invited',
  keynote: 'Keynote',
  poster: 'Poster',
  webinar: 'Webinar',
  short: 'Short comm.',
  participation: 'Participation',
}[type];
---

<article class="card">
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="font-serif text-base leading-snug text-ink-900 dark:text-ink-50">{title}</h3>
    <span class="text-sm text-ink-500 dark:text-ink-400 tabular-nums">{date}</span>
  </header>
  <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">
    <span class="badge badge-accent mr-2">{typeLabel}</span>
    {venue}{location ? ` — ${location}` : ''}
  </p>
  {abstract && <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{abstract}</p>}
  {(slides || video || paper) && (
    <div class="mt-3 flex flex-wrap gap-3 text-sm">
      {slides && <a class="text-accent-600 dark:text-accent-300" href={slides}>Slides</a>}
      {video && <a class="text-accent-600 dark:text-accent-300" href={video}>Video</a>}
      {paper && <a class="text-accent-600 dark:text-accent-300" href={paper}>Related paper</a>}
    </div>
  )}
</article>
