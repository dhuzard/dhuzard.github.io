---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  wide?: boolean;
}
const { id, eyebrow, title, description, wide = false } = Astro.props;
const container = wide ? 'container-wide' : 'container-prose';
---

<section id={id} class="py-12 sm:py-16">
  <div class={container}>
    <header class="mb-6">
      {eyebrow && <p class="section-eyebrow mb-2">{eyebrow}</p>}
      <h2 class="section-title">{title}</h2>
      {description && <p class="mt-3 text-ink-600 dark:text-ink-300">{description}</p>}
    </header>
    <div class="space-y-6">
      <slot />
    </div>
  </div>
</section>
