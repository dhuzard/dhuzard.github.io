---
import scholar from '~/data/scholar.json';

// Metrics are fetched at build time (see scripts/fetch-scholar.mjs) — Google
// Scholar blocks live/browser access, so we render the last-known-good values
// with an "updated" date and a link to the live profile.
const hasData = scholar.citations != null;

const tiles = [
  { label: 'Citations', value: scholar.citations, recent: scholar.citationsRecent },
  { label: 'h-index', value: scholar.hIndex, recent: scholar.hIndexRecent },
  { label: 'i10-index', value: scholar.i10Index, recent: scholar.i10Recent },
];

const nf = new Intl.NumberFormat('en-US');
---

<div class="rounded-xl border border-ink-200 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
  <div class="flex items-center justify-between gap-4">
    <h3 class="font-serif text-base text-ink-900 dark:text-ink-50">
      <a href={scholar.profileUrl} class="no-underline hover:underline">Google&nbsp;Scholar</a>
    </h3>
    {hasData && scholar.updated && (
      <span class="text-xs text-ink-500 dark:text-ink-400 tabular-nums">
        Updated {scholar.updated}
      </span>
    )}
  </div>

  {hasData ? (
    <>
      <dl class="mt-4 grid grid-cols-3 gap-3">
        {tiles.map((t) => (
          <div class="rounded-lg bg-ink-50 px-3 py-3 text-center dark:bg-ink-950">
            <dt class="text-xs font-medium uppercase tracking-wide text-ink-500 dark:text-ink-400">
              {t.label}
            </dt>
            <dd class="mt-1 font-serif text-2xl tabular-nums text-ink-900 dark:text-ink-50">
              {t.value != null ? nf.format(t.value) : '—'}
            </dd>
            {t.recent != null && scholar.sinceYear && (
              <dd class="mt-0.5 text-[11px] text-ink-400 dark:text-ink-500 tabular-nums">
                +{nf.format(t.recent)} since {scholar.sinceYear}
              </dd>
            )}
          </div>
        ))}
      </dl>
      <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">
        <a href={scholar.profileUrl}>View full profile on Google Scholar →</a>
      </p>
    </>
  ) : (
    <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">
      Live citation metrics, h-index and i10-index are published on my
      <a href={scholar.profileUrl}> Google Scholar profile</a>.
    </p>
  )}
</div>
